# BarberElite - Variables de entorno
# Copia este archivo a .env y completa tus valores reales
# cp .env.example .env

# Supabase PostgreSQL - lo encuentras en Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Frontend URL para CORS (en local: http://localhost:3001, en Render: https://tu-frontend.onrender.com)
FRONTEND_URL=*

# Telegram Bot para notificaciones (creado con @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789,987654321

# Contraseña para /api/login del panel admin
ADMIN_PASS=barberia2025

# Puerto del servidor (Render asigna PORT automáticamente)
PORT=3001
